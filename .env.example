# Database Connection (Hosted PostgreSQL connection string)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require

# AES-256 Data Encryption Key (Generate a 64-character hex key)
DATA_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Initial Admin Credentials (Required for production deployments)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars

# Local Server Port (Optional)
PORT=3000
